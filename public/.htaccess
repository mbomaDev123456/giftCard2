# Tozeur Souk — réécriture et en-têtes. Copie de la maison (ZF2) + protections.
Options -Indexes -MultiViews
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers et dossiers réels : servis tels quels.
    RewriteCond %{REQUEST_FILENAME} -s [OR]
    RewriteCond %{REQUEST_FILENAME} -l [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^.*$ - [NC,L]

    # Tout le reste part dans le contrôleur frontal.
    RewriteCond %{REQUEST_URI}::$1 ^(/.+)(.+)::\2$
    RewriteRule ^(.*) - [E=BASE:%1]
    RewriteRule ^(.*)$ %{ENV:BASE}index.php [NC,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Les uploads sont couverts par public/uploads/.htaccess (aucun code ne doit s'y exécuter).

<IfModule php_module>
    php_flag display_errors Off
    php_value upload_max_filesize 8M
    php_value post_max_size 12M
</IfModule>
